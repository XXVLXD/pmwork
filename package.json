{
  "name": "roadly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/notices.mjs",
    "package": "node scripts/package.mjs",
    "pages:prepare": "npm run build && npm run package && node scripts/pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.52.0",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
